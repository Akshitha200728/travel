# TravelMate AI Environment Configuration Template
# Rename this file to .env and insert your API keys

# Google Gemini LLM API Key (Optional: RAG engine falls back to grounded synthesis if not set)
GEMINI_API_KEY=your_gemini_api_key_here

# Wikimedia API User Agent Identification Contact Info
WIKIMEDIA_USER_AGENT=TravelMateAI/1.0 (https://github.com/travelmate-ai; travelmate-ai-contact@example.com)

# Server Environment Configuration
FLASK_ENV=development
PORT=5000
